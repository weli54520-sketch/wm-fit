<?xml version="1.0" encoding="utf-8"?>
<!-- خصوصية: ما نسمح لأي نسخة احتياطية تلقائية تطلع من الجوال (جوجل درايف أو نقل جهاز).
     النسخة الاحتياطية الوحيدة هي ملف يحفظه المستخدم بنفسه من داخل التطبيق. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
